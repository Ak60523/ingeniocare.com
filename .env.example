# Local Vite uses the production data API from amplify_outputs.json
# (custom.dataApiUrl) via a same-origin /api proxy. Set this only to point
# at a different Function URL.
# VITE_API_URL=https://xxxx.lambda-url.us-east-1.on.aws

# Optional. FAB receptionist iframe origin (default https://growgent.ai).
# Local Growgent: VITE_GROWGENT_ORIGIN=http://127.0.0.1:5177
# VITE_GROWGENT_ORIGIN=
