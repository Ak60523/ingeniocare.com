# PostgreSQL (local Docker or Amazon Aurora PostgreSQL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ingenio
POSTGRES_PASSWORD=ingenio
POSTGRES_DATABASE=ingeniocare
# Set to false for local Docker Postgres
POSTGRES_SSL=false
# Optional: DATABASE_URL=postgres://ingenio:ingenio@127.0.0.1:5432/ingeniocare

API_PORT=3001
# 127.0.0.1 on EC2 when Nginx terminates HTTPS in front of the API
API_HOST=127.0.0.1
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated browser origins. Local: http://localhost:5173
# Prod: https://ingeniocare.com,https://www.ingeniocare.com,https://main.xxxxx.amplifyapp.com
CORS_ORIGIN=http://localhost:5173
# Public Amplify URL used in invite emails (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173
# First account with this email becomes the platform owner
OWNER_EMAIL=alex.kumar@ingeniocare.com

# Leave empty in local dev so Vite proxies /api to port 3001.
# Cloud builds use amplify_outputs.json custom.dataApiUrl from ampx pipeline-deploy.
VITE_API_URL=

# Optional. FAB receptionist iframe origin (default https://growgent.ai).
# Local Growgent: VITE_GROWGENT_ORIGIN=http://127.0.0.1:5177
# VITE_GROWGENT_ORIGIN=

# Local Docker only. Lambda in Amplify uses IAM for Bedrock (no access keys)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional override; default is us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_SONNET_MODEL_ID=
# Optional. Public S3 bucket for blog/news/paper figures (Amplify sets this in Lambda).
# Leave empty locally to store generated/uploaded images under public/content-images/.
# CONTENT_IMAGES_BUCKET=
# Optional Bedrock image model; default amazon.nova-canvas-v1:0 (falls back to Titan v2).
# BEDROCK_IMAGE_MODEL_ID=
