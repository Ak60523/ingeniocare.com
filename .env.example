# Aurora MySQL (or local MySQL 8 for development)
AURORA_HOST=your-cluster.cluster-xxxxx.us-east-1.rds.amazonaws.com
AURORA_PORT=3306
AURORA_USER=admin
AURORA_PASSWORD=
AURORA_DATABASE=ingeniocare
# Set to false for local Docker MySQL
AURORA_SSL=true

API_PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Used by the React production build
VITE_API_URL=
